<odoo>
    <record id="view_partner_form_loyalty" model="ir.ui.view">
        <field name="name">res.partner.form.loyalty</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Loyalty">
                    <group>
                        <field name="x_offer_prod1_ean"/>
                        <field name="x_offer_prod2_ean"/>
                        <field name="x_offer_discount_pct"/>
                        <field name="x_offer_updated_at"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
